<?xml version="1.0" encoding="utf-8"?>
<!-- One widget that follows its size: the Add button alone when small, its figures beside it when wider.
     What the figures are is chosen per widget (WidgetConfigActivity): optional when placing it, and again by reconfiguring it.
     No periodic update: FullaWidget redraws it when rows change, and at midnight. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_add"
    android:previewLayout="@layout/widget_preview"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:configure="io.github.sirallap.fulla.widget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
